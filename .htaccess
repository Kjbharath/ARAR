Options -Indexes

# ─────────────────────────────────────────────
# Clean URLs — remove .html extensions
# ─────────────────────────────────────────────
RewriteEngine On

# ── 1. Redirect index.html and index files directly to their clean paths ──
# e.g. /index.html          → /
# e.g. /careers/index.html  → /careers/
# e.g. /careers/index       → /careers/

# Root index.html -> /
RewriteCond %{THE_REQUEST} \s/+(index)?\.html[\s?] [NC]
RewriteRule ^ / [R=301,L,NE]

# Subdirectory index.html -> subdirectory/
RewriteCond %{THE_REQUEST} \s/+(.+?)/index\.html[\s?] [NC]
RewriteRule ^ /%1/ [R=301,L,NE]

# Subdirectory index -> subdirectory/
RewriteCond %{THE_REQUEST} \s/+(.+?)/index[\s?/] [NC]
RewriteRule ^ /%1/ [R=301,L,NE]

# Root index -> /
RewriteRule ^index/?$ / [R=301,L]


# ── 2. Strip .html extension from other requests ──
# e.g. /about.html → /about
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]


# ── 3. Internally serve .html file when clean URL is requested ──
# e.g. /about → serves about.html (if it exists) without redirect
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
